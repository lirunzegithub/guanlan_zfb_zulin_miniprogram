<view class="page">

  <block a:if="{{list.length > 0}}">
    <block a:for="{{list}}" a:key="id">
      <view class="addr" data-id="{{item.id}}" onTap="onEdit">
        <view class="line1">
          <text class="name">{{item.receiver_name}}</text>
          <text class="phone">{{item._phoneMasked}}</text>
          <text a:if="{{item.is_default}}" class="badge default">默认</text>
          <text a:if="{{item.source === 'alipay'}}" class="badge alipay">支付宝</text>
        </view>
        <view class="addr-detail">{{item.province}} {{item.city}} {{item.district}} {{item.detail}}</view>
        <view class="actions" catchTap="noop">
          <view a:if="{{!item.is_default}}" class="act-btn" data-id="{{item.id}}" catchTap="onSetDefault">设为默认</view>
          <view class="act-btn" data-id="{{item.id}}" catchTap="onEdit">编辑</view>
          <view class="act-btn danger" data-id="{{item.id}}" catchTap="onDelete">删除</view>
        </view>
      </view>
    </block>
  </block>

  <view a:elif="{{loaded}}" class="empty">
    <view class="empty-ico"></view>
    <text>还没有地址，请添加一个</text>
  </view>

  <view class="fab" onTap="onAdd">＋ 新增地址</view>
</view>
