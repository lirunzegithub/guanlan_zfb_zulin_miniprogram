.page {
  min-height: 100vh;
  padding: 96rpx 56rpx 0;
  background: #f4f7fb;
  display: flex; flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.logo {
  width: 160rpx; height: 160rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg,#4d8dff,#2b7cff);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 18rpx 40rpx rgba(43,124,255,0.32);
}
.logo-dot {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: #fff;
  position: relative;
}
.logo-dot::after {
  content: '✓';
  position: absolute; inset: 0;
  color: #2b7cff; font-size: 44rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
}

.brand {
  margin-top: 48rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: #1a1f2e;
  letter-spacing: 2rpx;
}
.hint {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.7;
  text-align: center;
  white-space: pre-wrap;
}

.btn-login {
  margin-top: 96rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(90deg, #4d8dff, #2b7cff);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 48rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 24rpx rgba(43,124,255,0.28);
  transition: 0.15s;
}
.btn-login:active { opacity: 0.88; }
.btn-login.disabled {
  opacity: 0.6;
  box-shadow: none;
}

.skip {
  margin-top: 36rpx;
  font-size: 26rpx;
  color: #6b7280;
  padding: 16rpx 32rpx;
}

.footer {
  position: absolute;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 0; right: 0;
  text-align: center;
  font-size: 22rpx;
  color: #9aa4b2;
}
