.page { padding: 24rpx 24rpx 40rpx; }

/* Banner */
.banner {
  position: relative;
  height: 240rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #cfe2ff 0%, #e7f0ff 100%);
  padding: 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.b-text { flex: 1; z-index: 2; }
.b-title { font-size: 36rpx; font-weight: 800; color: #1a1f2e; }
.b-sub { font-size: 22rpx; color: #5a6577; margin-top: 6rpx; }
.b-brand {
  display: flex; align-items: center;
  margin-top: 16rpx;
  font-size: 20rpx; color: #6b7280;
}
.brand-dot {
  width: 14rpx; height: 14rpx;
  background: var(--primary);
  border-radius: 50%;
  margin-right: 8rpx;
}

.b-photo {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 224rpx; height: 224rpx;
  border-radius: 50%;
  /* 图片已预合成为正方形（人物居中 + 同 banner 色系蓝底），直接 cover 即可，
     圆形裁掉的角落是蓝底，与 banner 无缝衔接，不再露白底 */
  object-fit: cover;
  border: 4rpx solid rgba(255,255,255,0.85);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.12);
}

/* 客服热线 */
.btn-single { margin-bottom: 28rpx; }
.big-btn {
  height: 160rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  padding: 0 36rpx;
  color: #fff;
  gap: 24rpx;
}
.hotline {
  background: linear-gradient(135deg, #4a7fff 0%, #1c4dd1 100%);
  box-shadow: 0 12rpx 28rpx rgba(28, 77, 209, 0.25);
}
.bb-text { flex: 1; }
.bb-ico {
  width: 80rpx; height: 80rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
  position: relative;
  flex-shrink: 0;
}
.ico-phone::before {
  content:''; position: absolute;
  left: 24rpx; top: 18rpx;
  width: 32rpx; height: 44rpx;
  background: #fff;
  border-radius: 8rpx;
  transform: rotate(-12deg);
}
.bb-title { font-size: 32rpx; font-weight: 800; line-height: 1.2; }
.bb-sub { font-size: 20rpx; opacity: 0.9; margin-top: 4rpx; }

/* FAQ */
.faq { padding: 8rpx 28rpx 16rpx; }
.faq-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}
.faq-title { font-size: 30rpx; font-weight: 700; color: #1a1f2e; }
.faq-more { font-size: 22rpx; color: #9aa4b2; }
.faq-list {}
.faq-item {
  padding: 28rpx 0;
  border-top: 1rpx solid var(--line);
}
.faq-item:first-child { border-top: none; }
.faq-item:active .faq-q { color: #2b7cff; }
.faq-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.faq-q {
  font-size: 28rpx;
  color: #1a1f2e;
  font-weight: 500;
  flex: 1;
  line-height: 1.5;
  transition: color 0.2s ease;
}
.faq-item.expanded .faq-q { color: #2b7cff; }
.arrow {
  font-size: 32rpx;
  color: #c5cdd9;
  flex-shrink: 0;
  display: inline-block;
  line-height: 1;
  transform-origin: center;
  transition: transform 0.25s ease, color 0.25s ease;
}
.faq-item.expanded .arrow {
  color: #2b7cff;
  transform: rotate(90deg);
}
.faq-a {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #e0e4ec;
  font-size: 26rpx;
  color: #4a5060;
  line-height: 1.75;
  white-space: pre-wrap;
}
.faq-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9aa4b2;
}

/* 客服悬浮按钮 mini icon */
.ico-headset-mini {
  width: 36rpx; height: 24rpx;
  border: 4rpx solid var(--primary);
  border-bottom: none;
  border-radius: 18rpx 18rpx 0 0;
  position: relative;
}
.ico-headset-mini::before, .ico-headset-mini::after {
  content: '';
  position: absolute;
  bottom: -14rpx;
  width: 12rpx; height: 18rpx;
  background: var(--primary);
  border-radius: 4rpx;
}
.ico-headset-mini::before { left: -2rpx; }
.ico-headset-mini::after { right: -2rpx; }
