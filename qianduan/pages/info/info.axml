<view class="page">

  <view class="hero hero-{{type}}">
    <view class="hero-icon">
      <view a:if="{{type === 'aftersale'}}" class="ic-shield"></view>
      <view a:else class="ic-lock"></view>
    </view>
    <view class="hero-title">{{title}}</view>
    <view class="hero-sub">{{subtitle}}</view>
  </view>

  <view class="card">
    <view class="card-title">
      <text class="card-title-bar"></text>
      <text>{{type === 'aftersale' ? '我们承诺' : '我们做了什么'}}</text>
    </view>

    <view class="list">
      <block a:for="{{items}}" a:key="*this">
        <view class="row">
          <view class="num">{{index + 1}}</view>
          <view class="text">{{item}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="card foot">
    <view class="foot-line"></view>
    <text class="foot-text">如有任何疑问，欢迎随时联系客服 400-000-0000</text>
    <view class="foot-btn" onTap="onCall">拨打客服热线</view>
  </view>

  <view style="height: 40rpx;"></view>
</view>
