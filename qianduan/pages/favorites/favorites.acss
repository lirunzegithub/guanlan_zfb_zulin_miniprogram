.page { min-height: 100vh; padding: 24rpx 24rpx 60rpx; }

.fav-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(30, 38, 60, 0.05);
}
.fav-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #f0f3f8;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  flex-shrink: 0;
}
.fav-body {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}
.fav-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1f2e;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.fav-meta {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 8rpx;
}
.price {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff2d2d;
}
.unit {
  font-size: 20rpx;
  color: #9aa4b2;
}
.sales {
  margin-left: auto;
  font-size: 22rpx;
  color: #9aa4b2;
}
.fav-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 12rpx;
}
.act-btn {
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--line, #e5e8ee);
  font-size: 24rpx;
  color: #4a5060;
}
.act-btn.danger { color: #ff2d2d; border-color: #ffd1cd; }
.act-btn.disabled { opacity: 0.5; }

/* 空态 */
.empty {
  padding-top: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}
.empty-ico {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #ffeaea;
  position: relative;
}
.empty-ico::before {
  /* 一颗灰色小心 */
  content: '';
  position: absolute;
  left: 50%; top: 50%;
  width: 60rpx; height: 50rpx;
  transform: translate(-50%, -52%);
  background:
    radial-gradient(circle at 18rpx 18rpx, #ffb3b0 18rpx, transparent 19rpx),
    radial-gradient(circle at 42rpx 18rpx, #ffb3b0 18rpx, transparent 19rpx);
}
.empty-ico::after {
  content: '';
  position: absolute;
  left: 50%; top: 56%;
  width: 38rpx; height: 38rpx;
  transform: translate(-50%, -50%) rotate(45deg);
  background: #ffb3b0;
}
.empty-text { font-size: 28rpx; color: #4a5060; font-weight: 600; }
.empty-sub  { font-size: 24rpx; color: #9aa4b2; }
.empty-btn {
  margin-top: 24rpx;
  padding: 16rpx 56rpx;
  border-radius: 44rpx;
  background: linear-gradient(90deg, #4d8dff, #2b7cff);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(43, 124, 255, 0.3);
}
