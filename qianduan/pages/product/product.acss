.page { padding-bottom: 0; background: #f4f7fb; }

/* 商品主图 */
.hero {
  position: relative;
  width: 100%;
  height: 720rpx;
  background: linear-gradient(135deg, #f4f7fb 0%, #dde6ef 100%);
  overflow: hidden;
}
.hero-swiper {
  width: 100%;
  height: 100%;
}
.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}
.hero-fallback {
  width: 100%;
  height: 100%;
  background-size: cover !important;
  background-position: center !important;
}
/* 芝麻信用品牌组件（合规：必须配 LOGO + 官方文案，不能只用文字 / 自制图标）
   官方两种合规形态：
     完整版：[LOGO] 芝麻信用｜免押金
     简化版：[LOGO] 芝麻免押
   .zmxy-logo 用 SVG/PNG 渲染，绝对不允许用 CSS 画的圆圈+勾代替。 */
.zmxy-logo {
  width: 36rpx; height: 36rpx;
  display: block;
  flex-shrink: 0;
}
.zmxy-logo-sm { width: 28rpx; height: 28rpx; }
.zmxy-brand {
  color: #3D8DFB;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.zhima-bar {
  display: flex; align-items: center;
  gap: 10rpx;
  background: linear-gradient(90deg,#dbeaff,#e9f1ff);
  padding: 16rpx 32rpx;
  font-size: 24rpx;
}
.zhima-bar-sub {
  color: #5a7ca8;
  font-size: 22rpx;
  margin-left: 4rpx;
}

/* 卡片基础 */
.card {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}

/* 价格卡 */
.promo-row { display: flex; justify-content: flex-end; align-items: center; }
.rented { font-size: 22rpx; color: #9aa4b2; }

.price-row {
  display: flex; align-items: baseline; gap: 6rpx;
  padding: 12rpx 0 18rpx;
  border-bottom: 1rpx solid var(--line);
}
.cny { color: #ff2d2d; font-size: 28rpx; font-weight: 400; }
.price { color: #ff2d2d; font-size: 52rpx; font-weight: 400; line-height: 1; }
.unit { color: #ff2d2d; font-size: 24rpx; margin-left: 8rpx; }

/* 标题卡 */
.t-name { font-size: 32rpx; font-weight: 800; color: #1a1f2e; }
.t-sub { font-size: 24rpx; color: #6b7280; margin-top: 8rpx; }
.t-tip { font-size: 22rpx; color: #ff2d2d; margin-top: 10rpx; }

/* 已选规格入口行（正文只读展示，点开抽屉去改） */
.sku-entry {
  display: flex; align-items: center; justify-content: space-between;
  gap: 20rpx;
}
.sku-entry-l { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.sku-entry-k { font-size: 28rpx; font-weight: 700; color: #1a1f2e; }
.sku-entry-v {
  font-size: 24rpx; color: #6b7280;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 规格/发货/活动 */
.info-card { padding: 8rpx 28rpx 24rpx; }
.info-row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.info-row:last-of-type { border-bottom: none; }
.info-k {
  width: 110rpx;
  font-size: 26rpx;
  color: #6b7280;
}
.info-v {
  flex: 1;
  display: flex; justify-content: space-between; align-items: center;
  font-size: 26rpx;
  color: #1a1f2e;
}
.ph { color: #c5cdd9; }
.arrow { color: #c5cdd9; font-size: 32rpx; }

.rights-row {
  display: flex;
  gap: 24rpx;
  padding: 22rpx 0 4rpx;
  border-top: 1rpx solid var(--line);
}
.right-item {
  font-size: 22rpx;
  color: #6b7280;
}

/* 发货说明 */
.note-title { font-size: 28rpx; font-weight: 700; color: #1a1f2e; margin-bottom: 16rpx; }
.note-body { font-size: 24rpx; color: #4a5060; line-height: 1.7; white-space: pre-wrap; }

/* 评价 */
.review-head {
  display: flex; justify-content: space-between; align-items: center;
  padding-bottom: 16rpx;
}
.review-title { font-size: 28rpx; font-weight: 700; color: #1a1f2e; }
.review-more { font-size: 22rpx; color: #9aa4b2; }
.rev-item {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--line);
}
.rev-top { display: flex; align-items: center; gap: 16rpx; }
.rev-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.rev-info { flex: 1; min-width: 0; }
.rev-name { font-size: 26rpx; color: #1a1f2e; font-weight: 600; }
.rev-stars { display: flex; gap: 4rpx; margin-top: 4rpx; }
.star { color: #d0d6e0; font-size: 22rpx; }
.star.on { color: #ffb800; }
.rev-time { font-size: 20rpx; color: #9aa4b2; }
.rev-text {
  margin-top: 14rpx;
  font-size: 24rpx; color: #4a5060; line-height: 1.6;
  white-space: pre-wrap;
}
.rev-empty {
  padding: 36rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9aa4b2;
}
.review-more {
  background: var(--primary-soft, #eaf2ff);
  color: var(--primary, #2b7cff);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

/* 评价输入弹层 */
.cmt-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.cmt-modal {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 36rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.cmt-h {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1f2e;
  margin-bottom: 24rpx;
}
.cmt-body { display: flex; flex-direction: column; gap: 20rpx; }
.cmt-stars { display: flex; align-items: center; gap: 8rpx; }
.cmt-star {
  font-size: 48rpx;
  color: #d0d6e0;
  padding: 4rpx;
}
.cmt-star.on { color: #ffb800; }
.cmt-star-tip { font-size: 22rpx; color: #9aa4b2; margin-left: 12rpx; }
.cmt-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 26rpx;
  color: #1a1f2e;
  padding: 18rpx 20rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 12rpx;
  background: #fafbfd;
  box-sizing: border-box;
  line-height: 1.6;
}
.cmt-f {
  display: flex; gap: 20rpx; margin-top: 28rpx;
}
.cmt-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  background: var(--primary, #2b7cff);
  color: #fff;
  font-weight: 600;
}
.cmt-btn.ghost {
  background: #f4f7fb;
  color: #4a5060;
}
.cmt-btn.disabled {
  opacity: 0.6;
}

/* 评价弹层：图片选择网格 */
.cmt-imgs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}
.cmt-img-cell {
  position: relative;
  width: 100%;
  padding-top: 100%;       /* 1:1 占位 */
  border-radius: 12rpx;
  overflow: hidden;
  background: #f4f6fa;
}
.cmt-img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  display: block;
}
.cmt-img-x {
  position: absolute;
  top: 4rpx; right: 4rpx;
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
  font-weight: 700;
}
.cmt-img-add {
  width: 100%;
  padding-top: 100%;
  position: relative;
  border: 2rpx dashed #c5cdd9;
  border-radius: 12rpx;
  background: #fafbfd;
  color: #6b7280;
}
.cmt-img-add.disabled { opacity: 0.6; }
.cmt-img-add-plus,
.cmt-img-add-tip,
.cmt-img-add-loading {
  position: absolute; left: 0; right: 0; text-align: center;
}
.cmt-img-add-plus    { top: 28%; font-size: 44rpx; color: #9aa4b2; }
.cmt-img-add-tip     { bottom: 18%; font-size: 20rpx; color: #9aa4b2; }
.cmt-img-add-loading {
  top: 50%; transform: translateY(-50%);
  font-size: 22rpx;
  color: var(--primary, #2b7cff);
}

/* 评价列表的图片网格：固定 120rpx 缩略图横向排列，超出自动换行 */
.rev-imgs {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.rev-img-cell {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f4f6fa;
  flex-shrink: 0;
}
.rev-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 介绍卡 */
.intro-card { padding: 28rpx 28rpx 32rpx; }
.intro-head {
  font-size: 30rpx;
  font-weight: 800;
  color: #1a1f2e;
  text-align: center;
  padding-bottom: 16rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid var(--line);
}
.intro-body {
  font-size: 26rpx;
  color: #4a5060;
  line-height: 1.85;
  white-space: pre-wrap;
}

/* 详情图片（后端 real_shots 渲染）—— 无缝拼接、紧贴上方 */
.detail-imgs {
  background: #fff;
  font-size: 0;
  line-height: 0;
}
.detail-img {
  display: block;
  width: 100%;
  vertical-align: top;
  background: transparent;
}

.rule-pad { padding: 32rpx; }
.rule-title { font-size: 28rpx; font-weight: 800; color: #1a1f2e; margin-bottom: 16rpx; }
.rule-body { font-size: 26rpx; color: #4a5060; line-height: 1.8; white-space: pre-wrap; }

/* ========== 定损标准 ========== */
.ds-card { padding: 32rpx 24rpx 28rpx; }
.ds-title {
  display: flex; align-items: center; justify-content: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.ds-title-text {
  font-size: 44rpx; font-weight: 900; color: #1a1f2e;
  letter-spacing: 4rpx;
}
.ds-title-deco {
  width: 28rpx; height: 28rpx;
  background: linear-gradient(135deg, #1bd4ff, #1990ff);
  transform: rotate(45deg);
  border-radius: 4rpx;
}
.ds-title-deco--r {
  background: linear-gradient(135deg, #1677ff, #155bff);
}

.ds-table {
  border: 1rpx solid #d8dee8;
  border-radius: 8rpx;
  overflow: hidden;
}
.ds-thead {
  display: flex;
  background: #eaf1fb;
  border-bottom: 1rpx solid #d8dee8;
}
.ds-th {
  padding: 18rpx 8rpx;
  font-size: 24rpx; color: #1a1f2e; font-weight: 700;
  text-align: center;
  line-height: 1.4;
}

.ds-group {
  display: flex;
  border-bottom: 1rpx solid #d8dee8;
  background: #fff;
}
.ds-group:last-child { border-bottom: none; }
.ds-type-cell {
  display: flex; align-items: center; justify-content: center;
  padding: 12rpx 8rpx;
  font-size: 22rpx; color: #1a1f2e; font-weight: 700;
  line-height: 1.45;
  text-align: center;
  border-right: 1rpx solid #d8dee8;
  background: #fff;
}
.ds-rows {
  flex: 1;
  display: flex; flex-direction: column;
}
.ds-row {
  display: flex;
  border-bottom: 1rpx dashed #e3e8f0;
}
.ds-row:last-child { border-bottom: none; }
.ds-row > text {
  padding: 18rpx 8rpx;
  font-size: 22rpx; color: #4a5060;
  text-align: center;
  line-height: 1.4;
  border-right: 1rpx solid #e3e8f0;
}
.ds-row > text:last-child { border-right: none; }
.ds-row .is-highlight {
  color: #ff2d2d;
  font-weight: 700;
}

/* 列宽：类型 / 程度 / 折旧 / 安心保（百分比按全表 24/30/23/23 切分） */
.ds-c-type   { flex: 0 0 24%; }
.ds-thead .ds-c-degree { flex: 0 0 30%; }
.ds-thead .ds-c-deprec { flex: 0 0 23%; }
.ds-thead .ds-c-insur  { flex: 0 0 23%; }
/* 表体的 degree/deprec/insur 落在 .ds-rows（占整表 76%）里，需按比例换算到该容器内 */
.ds-row .ds-c-degree { flex: 0 0 39.47%; }
.ds-row .ds-c-deprec { flex: 0 0 30.26%; }
.ds-row .ds-c-insur  { flex: 0 0 30.27%; }

.ds-notice {
  margin-top: 24rpx;
  padding: 28rpx 28rpx;
  background: linear-gradient(135deg, #4d8dff, #2b7cff);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  border-radius: 14rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

/* 底部固定 */
.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
  z-index: 90;
}
.bb-actions {
  height: 120rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
/* 协议勾选样式已随该行一起移至确认订单页 */

/* 底部分享 / 收藏（替换原来的 首页 / 客服） */
.bb-act {
  width: 96rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 8rpx;
  padding: 6rpx 0;
  font-size: 20rpx;
  color: #4a5060;
  transition: color .18s;
}
.bb-act:active { opacity: .65; }
.bb-act.is-on { color: #ff2d2d; }
.bb-act-text {
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 1rpx;
}
.bb-act-ico {
  width: 44rpx; height: 44rpx;
  position: relative;
}
/* 分享图标：经典 3 圆点 + 2 连线（Material 风），SVG 内联保证清晰锐利 */
.bb-act-share {
  background: no-repeat center / 40rpx 40rpx
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234a5060' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='18' cy='5' r='3'/><circle cx='6' cy='12' r='3'/><circle cx='18' cy='19' r='3'/><line x1='8.59' y1='13.51' x2='15.42' y2='17.49'/><line x1='15.41' y1='6.51' x2='8.59' y2='10.49'/></svg>");
}
/* 收藏图标：纯文本心型，切换填充 + 颜色 + 微弹动 */
.bb-act-fav {
  display: flex; align-items: center; justify-content: center;
}
.bb-act-fav::before {
  content:'♡';
  font-size: 44rpx;
  line-height: 1;
  color: currentColor;
  transition: color .2s, transform .2s;
}
.bb-act-fav.on::before {
  content:'♥';
  color: #ff2d2d;
  text-shadow: 0 2rpx 8rpx rgba(255, 45, 45, .35);
  transform: scale(1.06);
}

/* 主行动按钮：单行合规版（LOGO + 完整版"芝麻信用｜免押金"） */
.bb-rent {
  flex: 1;
  margin-left: 20rpx;
  height: 84rpx;
  background: linear-gradient(90deg, #4d8dff, #2b7cff);
  color: #fff;
  border-radius: 42rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 20rpx rgba(43,124,255,0.3);
  transition: 0.15s;
}
/* 库存售罄态：灰底、不可点感 */
.bb-rent.sold-out {
  background: #c5cdd9;
  box-shadow: none;
}
.bb-rent.disabled {
  background: #c5d2e6;
  box-shadow: none;
}

/* ============ 租期选择抽屉 ============ */
.rent-mask {
  position: fixed; inset: 0;
  background: rgba(15, 22, 40, 0.45);
  z-index: 999;
  display: flex; align-items: flex-end;
  animation: rsFade .18s ease both;
}
@keyframes rsFade { from { opacity: 0; } to { opacity: 1; } }

/* 抽屉定高：中间 .rs-body 靠 flex:1 拿到确定高度才滚得动
   （高度 auto 时 flex:1 会塌成 0，scroll-view 也就不滚）。
   收起日历时矮一些，展开时给日历更多空间。 */
.rent-sheet {
  position: relative;
  width: 100%;
  height: 76vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(15, 22, 40, 0.12);
  display: flex; flex-direction: column;
  overflow: hidden;
  animation: rsSlideUp .26s cubic-bezier(.2,.8,.2,1) both;
}
@keyframes rsSlideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

/* ----- 顶部标题 ----- */
/* 头部只剩关闭按钮：给一个固定高度，否则内容为空时会塌陷、
   绝对定位的 × 会盖到下方商品摘要上 */
/* 关闭按钮浮在抽屉右上角（原来它独占一行 76rpx，其余全是空白）。
   z-index 压过滚动内容，摘要区用 padding-right 给它让位。 */
.cal-close {
  position: absolute; right: 14rpx; top: 10rpx;
  z-index: 10;
  width: 64rpx; height: 64rpx;
  line-height: 60rpx; text-align: center;
  font-size: 42rpx; color: #9aa4b2;
}
.cal-close:active { color: #1a1f2e; }

/* ----- 抽屉顶部：商品摘要（当前规格 + 当前租期的价格） ----- */
.rs-summary {
  display: flex; align-items: center; gap: 18rpx;
  padding: 24rpx 84rpx 18rpx 28rpx;
}
.rs-thumb {
  width: 112rpx; height: 112rpx;
  border-radius: 16rpx;
  background: #f4f7fb;
  flex-shrink: 0;
}
.rs-thumb-ph { border: 2rpx dashed #dfe5ee; }
.rs-sum-body { flex: 1; min-width: 0; }
/* 价格：¥ / 数字 / 单位 同字号同字重，不加粗（对齐参考稿的清爽观感） */
.rs-price { display: flex; align-items: baseline; }
.rs-price-cny,
.rs-price-num,
.rs-price-unit {
  font-size: 34rpx;
  color: #ff2d2d;
  font-weight: 400;
}
.rs-sum-sub { display: block; font-size: 23rpx; color: #6b7280; margin-top: 6rpx; }
.rs-sum-dep { display: block; font-size: 21rpx; color: #9aa4b2; margin-top: 2rpx; }

/* ----- 抽屉内区块标题 ----- */
.rs-block { padding: 0; }
.rs-sec-title {
  display: block;
  font-size: 27rpx; font-weight: 700; color: #1a1f2e;
  margin: 0 28rpx 16rpx;
}
.rs-sec-title--pad { margin-top: 12rpx; }

/* ----- 规格套餐列表：不再自己滚动（跟 .rs-body 一起滚），套餐多少都不会被裁 ----- */
.rs-sku-item {
  display: flex; align-items: center; justify-content: space-between;
  gap: 14rpx;
  margin: 0 28rpx 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  background: #f4f5f7;
}
.rs-sku-l { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
/* 套餐名常常很长（"【音画全能】全能版(标配+增广镜+补光灯+DJI Mic3)"），
   限死两行，避免单个条目把整块撑高 */
.rs-sku-name {
  font-size: 24rpx; font-weight: 400; color: #1a1f2e;
  line-height: 1.35;
  overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.rs-sku-meta { font-size: 21rpx; color: #6b7280; }
.rs-sku-item.on { background: #fff; border-color: var(--primary); }
.rs-sku-item.on .rs-sku-name { color: var(--primary); }
.rs-sku-item.on .rs-sku-meta { color: #6f9ae8; }
/* 无货规格仍可点选（让用户看到它的价格），只做视觉弱化 + 角标 */
.rs-sku-item.out { opacity: 0.55; }
.rs-sku-out {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background: #e7eaf0;
  color: #6b7280;
  font-size: 20rpx;
}

/* ----- 租期档位 ----- */
/* 换行网格：横向滚动放不下时会把末尾的「自选租期」推出屏幕外
   （用户反馈"看不到自选租期"就是这么来的） */
.cal-presets {
  display: flex; flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 28rpx 4rpx;
}
/* 未选中：浅灰填充、无描边；选中：白底 + 主色描边 + 主色文字 */
.cal-chip {
  min-width: 150rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  background: #f4f5f7;
  color: #1a1f2e;
  font-size: 25rpx;
  line-height: 1.2;
  text-align: center;
}
.cal-chip.on {
  background: #fff;
  border-color: var(--primary);
  color: var(--primary);
}

/* ----- 星期标签 ----- */
.cal-week {
  display: flex;
  padding: 12rpx 16rpx 16rpx;
  border-bottom: 1rpx solid #eef1f6;
}
.cal-week-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx; color: #9aa4b2;
}
.cal-week-cell:first-child,
.cal-week-cell:last-child {
  color: #ff8a3d;
}

/* ----- 滚动区 ----- */
/* 抽屉中间的唯一滚动区：摘要 / 规格 / 租期 / 日历都在这里滚 */
.rs-body {
  flex: 1;
  min-height: 0;
  background: #fff;
}
.rent-sheet.has-cal { height: 90vh; }
.cal-body { background: #fff; }
/* 手选关闭：日历整块降透明度示意"只读"，选中区间仍可见（由快捷预设驱动） */
.cal-scroll--locked { opacity: 0.55; }
.cal-month-label {
  text-align: center;
  padding: 28rpx 0 12rpx;
  font-size: 28rpx; color: #1a1f2e; font-weight: 700;
}
.cal-grid {
  display: flex; flex-wrap: wrap;
  padding: 0 8rpx;
}
.cal-cell {
  position: relative;
  width: 14.2857%;
  height: 112rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 4rpx;
}
.cal-cell--empty { background: transparent; }
.cal-day {
  font-size: 28rpx; color: #1a1f2e;
  font-weight: 600; line-height: 1;
}
.cal-price {
  font-size: 18rpx; color: #9aa4b2; line-height: 1;
}
.cal-price.is-ship {
  color: #ff8a3d; font-weight: 600;
}
.cal-cell--disabled .cal-day { color: #d2d6df; }
.cal-cell--disabled .cal-price { color: #e0e3eb; }

/* 起/止/区间 高亮 */
.cal-tag {
  position: absolute;
  top: 6rpx; right: 10rpx;
  font-size: 16rpx;
  background: #1a1f2e;
  color: #fff;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  letter-spacing: 1rpx;
}
.cal-cell--start,
.cal-cell--end,
.cal-cell--start-only {
  background: #ffd944;
}
.cal-cell--start .cal-day,
.cal-cell--end .cal-day,
.cal-cell--start-only .cal-day {
  color: #1a1f2e; font-weight: 800;
}
.cal-cell--start .cal-price,
.cal-cell--end .cal-price,
.cal-cell--start-only .cal-price {
  color: #5d4500; font-weight: 600;
}
.cal-cell--start .cal-price.is-ship,
.cal-cell--end .cal-price.is-ship,
.cal-cell--start-only .cal-price.is-ship {
  color: #b25a00;
}
.cal-cell--mid {
  background: #fff5cf;
}
.cal-cell--mid .cal-price { color: #8a6a00; }
.cal-cell--mid .cal-price.is-ship { color: #cc6f00; }

/* 物流期方块：整格独立配色（淡蓝），与选区的黄色明显区分 */
.cal-cell.is-ship.cal-cell--mid {
  background: #e7f1ff;
}
.cal-cell.is-ship.cal-cell--mid .cal-day {
  color: #1f63d6;
}
.cal-cell.is-ship.cal-cell--mid .cal-price {
  color: #2b7cff;
  font-weight: 700;
}
/* 等待选归还日时：在物流期 + 最少租期内的格子不可作为归还日，做"已计入"的提示态：
 * 文字稍淡 + 斜线条纹，物流蓝/价格色保留，让用户一眼看出这些天数被锁进起步租期里。
 */
.cal-cell.end-disabled {
  background-image: repeating-linear-gradient(
    135deg,
    rgba(0,0,0,0.04) 0,
    rgba(0,0,0,0.04) 6rpx,
    transparent 6rpx,
    transparent 14rpx
  );
}
.cal-cell.end-disabled .cal-day { color: #b9c0cd; }
.cal-cell.end-disabled:not(.is-ship) .cal-price { color: #c8ced8; }

/* "最早可还"角标 + 高亮 */
.cal-tag--earliest {
  background: linear-gradient(135deg, #ff8a3d, #ff6b1a) !important;
  letter-spacing: 0 !important;
  padding: 2rpx 6rpx !important;
  font-size: 16rpx !important;
}
.cal-cell.is-earliest {
  background: #fff4e6;
  border-radius: 12rpx;
}
.cal-cell.is-earliest .cal-day { color: #ff6b1a; font-weight: 800; }
.cal-cell.is-earliest .cal-price { color: #ff8a3d; }
.cal-cell.is-earliest::before {
  content: '';
  position: absolute;
  inset: 4rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #ff8a3d;
  pointer-events: none;
}

/* ----- 底部汇总 + 确认 ----- */
.cal-foot {
  position: relative;
  flex-shrink: 0;
  padding: 14rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eef1f6;
}

/* 浮动提示卡：贴 cal-foot 顶部，往上浮出 */
.cal-inline-tip {
  position: absolute;
  left: 24rpx; right: 24rpx;
  bottom: calc(100% + 12rpx);
  z-index: 10;
  display: flex; align-items: flex-start; gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 22, 40, 0.18);
  animation: tipPop .22s cubic-bezier(.2,.8,.2,1) both;
}
@keyframes tipPop {
  from { opacity: 0; transform: translateY(12rpx) scale(.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.cal-inline-tip--warn {
  background: linear-gradient(135deg, #ff6464, #ff3d3d);
  color: #fff;
}
.cal-inline-tip--info {
  background: linear-gradient(135deg, #ffb84d, #ff8a3d);
  color: #fff;
}
.cal-inline-tip-ico {
  flex: none;
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.22);
  color: #fff;
  font-size: 32rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  font-family: serif;
}
.cal-inline-tip-body {
  flex: 1;
  display: flex; flex-direction: column; gap: 4rpx;
  min-width: 0;
}
.cal-inline-tip-title {
  font-size: 28rpx; font-weight: 800; line-height: 1.2;
  color: #fff;
}
.cal-inline-tip-text {
  font-size: 22rpx; line-height: 1.5;
  color: rgba(255,255,255,0.92);
}


/* 送达提示条：通栏横条——左右贴边、不带圆角，紧贴确认按钮区上沿。
   带圆角+左右留白会让它看起来像个可点的按钮，实际它只是条说明。
   芝麻信用品牌表达由详情页顶部的 .zhima-bar 与确认订单页承担，这里不重复。 */
.cal-hint-bar {
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  gap: 10rpx;
  padding: 18rpx 24rpx;
  background: #eaf1fe;
}
/* 闪电图标用 CSS 画：Unicode ⚡ 在 iOS 会渲染成黄色彩色 emoji，
   跟这里的蓝色文案对不上，也无法着色 */
.cal-hint-ico {
  width: 18rpx; height: 26rpx;
  flex-shrink: 0;
  background: var(--primary);
  clip-path: polygon(62% 0%, 16% 58%, 44% 58%, 38% 100%, 84% 42%, 56% 42%);
  -webkit-clip-path: polygon(62% 0%, 16% 58%, 44% 58%, 38% 100%, 84% 42%, 56% 42%);
}
.cal-hint-text { font-size: 23rpx; color: #3d6fc4; }

/* 主确认按钮：全宽单行（与「规格选择弹层」的视觉一致） */
.cal-confirm {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #3D8DFB, #2B7CFF);
  color: #fff;
  font-size: 32rpx; font-weight: 700;
  letter-spacing: 2rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(43, 124, 255, 0.32);
}
.cal-confirm:active { opacity: .88; }
.cal-confirm.disabled {
  background: #d6dbe3;
  color: #fff;
  box-shadow: none;
}

/* ============ 自定义分享抽屉 ============ */
.share-mask {
  position: fixed; inset: 0;
  background: rgba(15, 22, 40, .45);
  z-index: 999;
  display: flex; align-items: flex-end;
  animation: rsFade .18s ease both;
}
.share-sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: rsSlideUp .26s cubic-bezier(.2,.8,.2,1) both;
}
.share-sheet-h {
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1f2e;
  padding-bottom: 30rpx;
}
.share-sheet-row {
  display: flex;
  justify-content: space-around;
  padding: 4rpx 0 28rpx;
}
/* 单个分享目标：图标 + 文案，图标边框尽量收紧（1rpx + 小圆角），不要太重 */
.share-tile {
  width: 120rpx;
  display: flex; flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.share-tile:active { opacity: .7; }
/* button reset，因为 "支付宝好友" tile 必须用 button[open-type=share] */
.share-tile-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1.2;
  height: auto;
  width: 120rpx;
}
.share-tile-btn::after { border: none; }
.share-tile-ico {
  width: 84rpx; height: 84rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 20rpx;
  background: #fafbfd;
  display: flex; align-items: center; justify-content: center;
  position: relative;
}
.share-tile-label {
  font-size: 22rpx;
  color: #4a5060;
  line-height: 1;
}
/* 支付宝好友：品牌蓝实底 + "支" 字（不要边框，让它从灰色 tile 里跳出来） */
.ico-friend {
  background: linear-gradient(135deg, #1990ff, #1677ff);
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(22, 119, 255, .25);
}
.ico-friend-text {
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}
/* 复制链接：链条图标，简洁线条风格 */
.ico-link {
  background: no-repeat center / 44rpx 44rpx #fafbfd
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234a5060' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71'/><path d='M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71'/></svg>");
}
/* 海报：小相框 + 太阳，强调 "图片" 输出 */
.ico-poster {
  background: no-repeat center / 44rpx 44rpx #fafbfd
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%234a5060' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='3' width='18' height='18' rx='2'/><circle cx='8.5' cy='9' r='1.6'/><polyline points='21,15 16,10 5,21'/></svg>");
}

/* 底部取消按钮：分隔线 + 大点击区 */
.share-sheet-cancel {
  text-align: center;
  font-size: 28rpx;
  color: #1a1f2e;
  padding: 28rpx 0 8rpx;
  border-top: 1rpx solid #eef1f6;
  margin-top: 4rpx;
}
.share-sheet-cancel:active { color: #6b7280; }

/* ========== 海报 ========== */
/* 离屏画布：逻辑 375×600 px，移出可视区只作绘制源（截图按 dpr 放大输出） */
.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 375px;
  height: 640px;
}
/* 海报预览弹层 */
.poster-mask {
  position: fixed; inset: 0;
  background: rgba(15, 22, 40, .62);
  z-index: 1000;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  animation: rsFade .18s ease both;
}
.poster-box {
  width: 100%;
  max-width: 560rpx;
  display: flex; flex-direction: column;
  align-items: center;
  animation: rsSlideUp .26s cubic-bezier(.2,.8,.2,1) both;
}
.poster-img {
  width: 100%;
  border-radius: 20rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, .35);
  background: #fff;
}
.poster-img-ph {
  height: 800rpx;
  display: flex; align-items: center; justify-content: center;
  color: #9aa4b2; font-size: 26rpx;
}
.poster-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
  width: 100%;
}
.poster-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 44rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}
.poster-btn:active { opacity: .85; }
.poster-btn-ghost {
  background: rgba(255, 255, 255, .16);
  color: #fff;
}
.poster-btn-main {
  background: linear-gradient(135deg, #1990ff, #1677ff);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(22, 119, 255, .35);
}
.poster-btn-main.is-disabled {
  opacity: .5;
}

/* ========== 详情页满减券展示 ========== */
.coupon-card-detail { padding: 24rpx 28rpx 24rpx; }
.cp-detail-h {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 16rpx;
}
.cp-detail-title { font-size: 28rpx; font-weight: 700; color: #1a1f2e; }
.cp-detail-more { font-size: 22rpx; color: #2b7cff; }
.cp-detail-scroll { width: 100%; white-space: nowrap; }
.cp-detail-row { display: flex; gap: 16rpx; padding: 4rpx 0 4rpx; }
.cp-mini {
  display: inline-flex;
  flex: 0 0 auto;
  background: linear-gradient(135deg, #fff5e6, #ffe2c2);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  min-width: 360rpx;
  box-shadow: 0 2rpx 8rpx rgba(240, 86, 11, 0.1);
}
.cp-mini-l {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding-right: 20rpx; margin-right: 20rpx;
  border-right: 2rpx dashed rgba(240, 86, 11, 0.35);
  color: #f0560b;
}
.cp-mini-cny { font-size: 22rpx; font-weight: 700; }
.cp-mini-num { font-size: 44rpx; font-weight: 800; line-height: 1; }
.cp-mini-r { flex: 1; min-width: 0; }
.cp-mini-name {
  font-size: 26rpx; color: #1a1f2e; font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.cp-mini-th { font-size: 22rpx; color: #8a4d1e; margin-top: 4rpx; }
.cp-mini-state {
  display: inline-block;
  font-size: 22rpx;
  margin-top: 10rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(240, 86, 11, 0.15);
  color: #f0560b;
}
.cp-mini-state.owned { background: rgba(43, 124, 255, 0.12); color: #2b7cff; }
.cp-mini-state.mute  { background: #eef1f6; color: #9aa4b2; }
.cp-mini-state.act   { background: linear-gradient(135deg,#ff7e3a,#f0560b); color:#ffffff; }

/* 抽屉内的选券行与选券抽屉样式已随功能一起移至确认订单页 */
