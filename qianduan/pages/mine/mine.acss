.page {
  min-height: 100vh;
  position: relative;
  padding: 0 24rpx 60rpx;
}
.header-bg {
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 360rpx;
  background: linear-gradient(180deg, #d6e4ff 0%, #f4f7fb 100%);
  z-index: 0;
}

/* 用户信息 */
.user {
  position: relative;
  z-index: 1;
  display: flex; align-items: center;
  padding: 32rpx 12rpx 36rpx;
}
.avatar {
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c5d2e6, #98a8c4);
  position: relative;
  flex-shrink: 0;
}
/* LOGO 头像：用配置图填充，盖掉默认渐变 + 伪元素 */
.avatar-img {
  background: #fff;
  display: block;
  overflow: hidden;
}
.avatar::before {
  content:''; position: absolute;
  left: 32rpx; top: 22rpx;
  width: 36rpx; height: 36rpx;
  background: #fff;
  border-radius: 50%;
}
.avatar::after {
  content:''; position: absolute;
  left: 16rpx; bottom: 12rpx;
  right: 16rpx;
  height: 30rpx;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
}
.u-info { margin-left: 20rpx; flex: 1; min-width: 0; }
.u-name { font-size: 30rpx; color: #1a1f2e; font-weight: 700;
          overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.u-sub { font-size: 22rpx; color: #6b7280; margin-top: 6rpx; }

/* Section 卡片 */
.section {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
}
.sec-head {
  display: flex; justify-content: space-between; align-items: center;
  padding-bottom: 20rpx;
}
.sec-title { font-size: 30rpx; font-weight: 700; color: #1a1f2e; }
.sec-more { font-size: 22rpx; color: var(--primary); }

/* 订单 5 列 */
.orders {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
}
.o-item {
  display: flex; flex-direction: column; align-items: center;
  gap: 12rpx;
}
.o-ico {
  width: 56rpx; height: 56rpx;
  position: relative;
}
.o-name { font-size: 22rpx; color: #4a5060; }

/* 简易图标：用边框/伪元素拼 */
.o-ico::before {
  content:''; position: absolute; inset: 0;
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
}
.o-ico.audit { color: #2b7cff; }
.o-ico.audit::after {
  content:'免'; position: absolute; left: 0; right: 0; top: 6rpx;
  text-align: center; font-size: 26rpx; color: #2b7cff; font-weight: 800;
}
.o-ico.send { color: #5aa9ff; }
.o-ico.send::after {
  content:''; position: absolute; left: 14rpx; right: 14rpx; top: 18rpx;
  height: 12rpx; border-top: 4rpx solid currentColor; border-bottom: 4rpx solid currentColor;
}
.o-ico.recv { color: #ff8a3d; }
.o-ico.recv::after {
  content:''; position: absolute; left: 12rpx; right: 12rpx; top: 14rpx; bottom: 12rpx;
  border: 4rpx solid currentColor;
  border-bottom: none;
}
.o-ico.using { color: #18b07b; }
.o-ico.using::after {
  content:'¥'; position: absolute; left: 0; right: 0; top: 6rpx;
  text-align: center; font-size: 24rpx; color: #18b07b; font-weight: 800;
}
.o-ico.all { color: #6b7280; }
.o-ico.all::after {
  content:''; position: absolute; left: 14rpx; right: 14rpx; top: 14rpx;
  height: 4rpx; background: currentColor; box-shadow: 0 10rpx 0 currentColor, 0 20rpx 0 currentColor;
}

/* 进行中的订单 */
.active-orders .sec-head { padding-bottom: 16rpx; }
.ao-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line, #eef0f4);
}
.ao-card:first-of-type { border-top: none; padding-top: 4rpx; }
.ao-thumb {
  width: 140rpx; height: 140rpx;
  border-radius: 14rpx;
  background: #f4f6fa;
  position: relative; overflow: hidden;
  flex-shrink: 0;
}
.ao-thumb-img {
  width: 100%; height: 100%;
  display: block;
  border-radius: 14rpx;
}
.ao-thumb-fallback {
  position: absolute; left: 0; right: 0; bottom: 8rpx;
  padding: 4rpx 8rpx;
  background: #ff2d2d;
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ao-info {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column;
  gap: 8rpx;
  padding-top: 4rpx;
}
.ao-top {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: 16rpx;
}
.ao-name {
  flex: 1; min-width: 0;
  font-size: 28rpx; font-weight: 700; color: #1a1f2e;
  line-height: 1.4;
  overflow: hidden;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.ao-status {
  flex-shrink: 0;
  font-size: 22rpx; font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.ao-status.st-primary { color: var(--primary, #2b7cff); background: rgba(43,124,255,0.10); }
.ao-status.st-warn    { color: #d18308; background: rgba(255,153,0,0.12); }
.ao-status.st-danger  { color: #d93026; background: rgba(217,48,38,0.10); }
.ao-status.st-success { color: #18b07b; background: rgba(24,176,123,0.10); }
.ao-meta {
  font-size: 22rpx; color: #6b7280;
}
.ao-bot {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: auto;
}
.ao-amount { font-size: 30rpx; color: #ff2d2d; font-weight: 800; }
.ao-cd {
  font-size: 22rpx; color: #d18308; font-weight: 600;
  font-feature-settings: 'tnum';
}
.ao-cd.overdue { color: #d93026; }

/* 功能 4 列 */
.funcs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 36rpx;
}
.f-item {
  display: flex; flex-direction: column; align-items: center;
  gap: 12rpx;
}
.f-ico {
  width: 64rpx; height: 64rpx;
  border-radius: 16rpx;
  position: relative;
}
.f-name { font-size: 22rpx; color: #4a5060; }

.f-ico.realname { background: linear-gradient(135deg,#7be0c0,#18b07b); }
.f-ico.realname::after {
  content:'V'; position: absolute; inset: 0; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 800; transform: scaleX(0.7);
}
.f-ico.fav { background: linear-gradient(135deg,#ffb6c8,#ff5a8b); }
.f-ico.fav::after {
  content:''; position: absolute;
  left: 18rpx; top: 22rpx; width: 28rpx; height: 26rpx;
  background:
    radial-gradient(circle at 6rpx 8rpx, #fff 7rpx, transparent 8rpx),
    radial-gradient(circle at 22rpx 8rpx, #fff 7rpx, transparent 8rpx);
}
.f-ico.fav::before {
  content:''; position: absolute;
  left: 18rpx; top: 28rpx; width: 0; height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 18rpx solid #fff;
}
.f-ico.addr { background: linear-gradient(135deg,#9ad5ff,#3a8dff); }
.f-ico.addr::after {
  content:''; position: absolute;
  left: 22rpx; top: 14rpx;
  width: 20rpx; height: 20rpx;
  background: #fff; border-radius: 50%;
  box-shadow: 0 0 0 6rpx transparent;
}
.f-ico.addr::before {
  content:''; position: absolute;
  left: 26rpx; top: 28rpx;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 18rpx solid #fff;
}
.f-ico.coupon { background: linear-gradient(135deg,#c8b8ff,#7d63ff); }
.f-ico.coupon::after {
  content:'¥'; position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx; font-weight: 800;
}
.f-ico.tel { background: linear-gradient(135deg,#a8f3d8,#18b07b); }
.f-ico.tel::after {
  content:''; position: absolute;
  left: 22rpx; top: 14rpx;
  width: 20rpx; height: 32rpx;
  background: #fff;
  border-radius: 6rpx;
  transform: rotate(-12deg);
}
.f-ico.feedback { background: linear-gradient(135deg,#ffd4b3,#ff7a3d); }
.f-ico.feedback::after {
  content:''; position: absolute;
  left: 14rpx; top: 16rpx; right: 14rpx;
  height: 24rpx;
  background: #fff;
  border-radius: 6rpx;
}
.f-ico.feedback::before {
  content:''; position: absolute;
  left: 26rpx; top: 38rpx;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 10rpx solid #fff;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: #9aa4b2;
  margin-top: 80rpx;
}
