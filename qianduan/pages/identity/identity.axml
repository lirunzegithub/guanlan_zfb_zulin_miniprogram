<view class="page">
  <!-- 顶部品牌区 -->
  <view class="hero">
    <view class="hero-deco deco-1"></view>
    <view class="hero-deco deco-2"></view>
    <view class="hero-inner">
      <view class="hero-text">
        <view class="hero-title">{{verified ? '已实名认证' : '实名信息验证'}}</view>
        <view class="hero-sub">{{verified ? '账号已通过支付宝实人认证' : '完成认证后即可享受免押租赁'}}</view>
      </view>
      <view class="hero-badge">
        <view class="ico-shield-big"></view>
      </view>
    </view>
  </view>

  <!-- ========== 已实名：只读展示卡片 ========== -->
  <view a:if="{{verified}}" class="card form-card">
    <view class="card-head">
      <view class="card-bar"></view>
      <text class="card-title">本人信息</text>
      <view class="card-tag verified-tag">
        <text>已认证</text>
      </view>
    </view>

    <view class="field">
      <view class="ico-wrap"><view class="ico-user"></view></view>
      <view class="field-body">
        <text class="field-label">姓名</text>
        <text class="field-value">{{info.name}}</text>
      </view>
    </view>

    <view class="field">
      <view class="ico-wrap"><view class="ico-phone"></view></view>
      <view class="field-body">
        <text class="field-label">手机号</text>
        <text class="field-value">{{info.phone}}</text>
      </view>
    </view>

    <view class="field last">
      <view class="ico-wrap"><view class="ico-id"></view></view>
      <view class="field-body">
        <text class="field-label">身份证号</text>
        <text class="field-value">{{info.idcard}}</text>
      </view>
    </view>
  </view>

  <view a:if="{{verified}}" class="verified-tip">
    <text>为保护您的账号安全，已脱敏显示。如需修改实名信息，请联系客服。</text>
  </view>

  <!-- ========== 未实名：原表单 ========== -->
  <view a:else class="card form-card">
    <view class="card-head">
      <view class="card-bar"></view>
      <text class="card-title">本人信息</text>
      <view class="card-tag">
        <view class="ico-lock-mini"></view>
        <text>信息加密</text>
      </view>
    </view>

    <view class="field">
      <view class="ico-wrap"><view class="ico-user"></view></view>
      <view class="field-body">
        <text class="field-label">姓名</text>
        <input class="field-input" placeholder="请输入真实姓名" placeholder-class="ph"
               value="{{form.name}}" data-k="name" onInput="onInput"/>
      </view>
    </view>

    <view class="field">
      <view class="ico-wrap"><view class="ico-phone"></view></view>
      <view class="field-body">
        <text class="field-label">手机号</text>
        <input class="field-input" placeholder="请输入 11 位手机号码" placeholder-class="ph"
               type="number" maxlength="11"
               value="{{form.phone}}" data-k="phone" onInput="onInput"/>
      </view>
    </view>

    <view class="field last">
      <view class="ico-wrap"><view class="ico-id"></view></view>
      <view class="field-body">
        <text class="field-label">身份证号</text>
        <input class="field-input" placeholder="请输入 18 位身份证号码" placeholder-class="ph"
               maxlength="18"
               value="{{form.idcard}}" data-k="idcard" onInput="onInput"/>
      </view>
    </view>
  </view>

  <!-- 同意条款（仅未实名时显示） -->
  <view a:if="{{!verified}}" class="agree" onTap="toggleAgree">
    <view class="check {{agree ? 'on' : ''}}"></view>
    <view class="agree-line">
      <text class="agree-text">请您阅读并同意</text>
      <text class="agree-link" catchTap="openPrivacy">《完善信息隐私政策》</text>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="submit-wrap safe-bottom">
    <view a:if="{{verified}}" class="submit on" onTap="onBack">
      <text>返回</text>
    </view>
    <view a:else class="submit {{canSubmit ? 'on' : ''}}" onTap="onSubmit">
      <text>确认提交</text>
    </view>
  </view>

</view>
