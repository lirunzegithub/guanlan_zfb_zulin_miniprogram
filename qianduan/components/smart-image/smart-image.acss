:host,
.smart-image {
  display: block;
  width: 100%;
  height: 100%;
}

.smart-image { position: relative; overflow: hidden; background: #f1f4f8; }
.smart-image-skeleton { position: absolute; inset: 0; background: #e9edf2; }
.smart-image-shimmer {
  position: absolute;
  top: 0; bottom: 0; left: -70%;
  width: 55%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.72), transparent);
  animation: smart-image-shimmer 1.25s ease-in-out infinite;
}
.smart-image-content {
  width: 100%; height: 100%; display: block;
  opacity: 0;
  transition: opacity .22s ease;
}
.smart-image-content.is-loaded { opacity: 1; }
.smart-image-error {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #8d98a8; font-size: 22rpx; background: #edf1f5;
}
.smart-image-error-icon { font-size: 38rpx; line-height: 1; margin-bottom: 8rpx; }

@keyframes smart-image-shimmer {
  from { transform: translateX(0); }
  to { transform: translateX(310%); }
}
